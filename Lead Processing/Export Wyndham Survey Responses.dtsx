      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{15658E45-DC0B-46D5-A344-25EF57876B94}"
          SQLTask:SqlStatementSource="DECLARE @Client varchar(50)&#xA;DECLARE @Sessionid uniqueidentifier&#xA;DECLARE @Partner nvarchar(50)&#xA;DECLARE @Procname varchar(128)&#xA;DECLARE @Procsection varchar(50)&#xA;DECLARE @Status bit&#xA;DECLARE @Errormessage nvarchar(2044)&#xA;&#xA;set @Client = ?&#xA;&#xA;EXECUTE [dbo].[Log_Lead_Export_Wyndham] &#xA;   @Client &#xA;  ,@Sessionid&#xA;  ,@Partner&#xA;  ,@Procname OUTPUT&#xA;  ,@Procsection OUTPUT&#xA;  ,@Status OUTPUT&#xA;  ,@Errormessage OUTPUT&#xA;GO" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::CompanyName"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="130"
            SQLTask:ParameterSize="-1" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
