    <DTS:Executable
      DTS:refId="Package\Get Count"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{8AF96639-C8BD-478F-8D4C-58D5ED815274}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:FailPackageOnFailure="True"
      DTS:FailParentOnFailure="True"
      DTS:LocaleID="-1"
      DTS:ObjectName="Get Count"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:LoggingOptions
        DTS:FilterKind="0" />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{15658E45-DC0B-46D5-A344-25EF57876B94}"
          SQLTask:SqlStatementSource="SET ? = (SELECT Count(* )AS [Count]&#xA;FROM [dbo].[Temp_Export_Leads_Wyndham] as t)" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::OutputCount"
            SQLTask:ParameterDirection="Output"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="-1" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Get Events"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{91615920-29DD-44A7-8C27-8C0D0B77A70B}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Get Events"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{4AC5D541-0329-4B36-BD6A-06E913F71FBA}"
          SQLTask:SqlStatementSource="Select v.Name AS Venue&#xA;&#x9;, e.Name as Event&#xA;&#x9;,cast(e.Event_Date__c as Date) as [Event Date]&#xA;&#x9;,Count(sr.id) as [Lead Count]&#xA;from SalesforceBackup.dbo.Event__c as e&#xA;join SalesforceBackup.dbo.Venue__c as v on e.Venue__c = v.id&#xA;left join SalesforceBackup.dbo.Survey_Response__c as sr on e.id = sr.Event__c&#xA;where v.Company__c = '0011U00002LNeJ9QAL' --Wyndham Destinations&#xA;and e.Event_Date__c &gt;=dateadd(dd,-5,GETDATE())&#xA;AND e.Event_Date__c &lt;=dateadd(dd,5,GETDATE())&#xA;group by  v.Name, e.Name,e.Event_Date__c&#xA;ORDER BY e.Event_Date__c"
          SQLTask:ResultType="ResultSetType_Rowset" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding
            SQLTask:ResultName="0"
            SQLTask:DtsVariableName="User::Events" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Log Lead Export Wyndham"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{636D0F69-AC24-44AE-875F-8F9258C9C68F}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Log Lead Export Wyndham"
