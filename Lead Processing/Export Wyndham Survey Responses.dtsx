          <DTS:Variables />
          <DTS:ObjectData>
            <ScriptProject
              Name="ST_52f6fcf4b9c94409918dda8ab82a76a3"
              VSTAMajorVersion="15"
              VSTAMinorVersion="0"
              Language="CSharp"
              ReadWriteVariables="User::ErrorEmailSent">
              <ProjectItem
                Name="ScriptMain.cs"
                Encoding="UTF8"><![CDATA[using System;
using Microsoft.SqlServer.Dts.Runtime;

public class ScriptMain : Microsoft.SqlServer.Dts.Tasks.ScriptTask.VSTARTScriptObjectModelBase
{
    public void Main()
    {
        try
        {
            Dts.Variables["User::ErrorEmailSent"].Value = true;
            Dts.TaskResult = (int)DTSExecResult.Success;
        }
        catch (Exception ex)
        {
            Dts.Events.FireError(0, "Set ErrorEmailSent", ex.ToString(), "", 0);
            Dts.TaskResult = (int)DTSExecResult.Failure;
        }
    }
}]]></ProjectItem>
