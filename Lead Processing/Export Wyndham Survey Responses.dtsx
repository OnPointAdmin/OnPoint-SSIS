        <DTS:Executable
          DTS:refId="Package.EventHandlers[OnError]\Send Package Error Email"
          DTS:CreationName="ZappySys.HtmlEmailTask"
          DTS:Description="ZS HTML Email Task"
          DTS:DTSID="{6A1537B2-7D7C-4E2E-8B9F-53A1FAC13132}"
          DTS:ExecutableType="ZappySys.HtmlEmailTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Send Package Error Email">
          <DTS:Variables />
          <DTS:ObjectData>
            <HtmlEmailTask
              SmtpConnection="SMTP"
              UseInlineStyle="False"
              IsHtmlEmail="True"
              DefaultStyle="&#xA;&lt;style type=&quot;text/css&quot;&gt;&#xA;body,div,p,span,td,th,table {&#xA; font-family: Helvetica, Arial, sans-serif;&#xA; font-size: 10pt; &#xA;}&#xA;h1,h2,h3,h4,h5{&#xA;font-family: Helvetica, Arial, sans-serif;&#xA;}&#xA;&#xA;table { &#xA; border-collapse: &#xA; collapse; border-spacing: 0; &#xA;}&#xA;&#xA;tr.odd    {background-color: #cccccc}&#xA;tr.even   {background-color: #fafafa}&#xA;td, th { border: 1px solid #bbb;padding: 5 5 5 5} &#xA;th { background: #F3F3F3;  font-weight: bold;}&#xA;&lt;/style&gt;&#xA;&#xA;"
              Subject="SSIS Error Alert - {{System::PackageName}}"
              From="jason.paine@onpointmrg.com"
              To="jason.paine@onpointmrg.com"
              Cc=""
              ReplyTo=""
              Bcc=""
              Attachments=""
              EmailPriority="Normal"
              MessageSourceType="Direct"
              MessageDirectValue="&lt;h3&gt;SSIS Package Failed&lt;/h3&gt;&#xA;&lt;p&gt;&#xA;Package: {{System::PackageName}}&lt;br/&gt;&#xA;Task: {{System::SourceName}}&lt;br/&gt;&#xA;Error: {{System::ErrorDescription}}&lt;br/&gt;&#xA;Time: {{System::StartTime}}&#xA;&lt;/p&gt;"
              MessageFileConnection=""
              MessageVariable=""
              LogLevel="Normal"
              PrefixTimestamp="False" />
          </DTS:ObjectData>
        </DTS:Executable>
      </DTS:Executables>
      <DTS:PrecedenceConstraints>
        <DTS:PrecedenceConstraint
          DTS:refId="Package.EventHandlers[OnError].PrecedenceConstraints[Constraint]"
          DTS:CreationName=""
          DTS:DTSID="{9FC8860E-040C-42E1-849C-ACD2662ACCFF}"
          DTS:From="Package.EventHandlers[OnError]\Send Package Error Email"
          DTS:LogicalAnd="True"
          DTS:ObjectName="Constraint"
          DTS:To="Package.EventHandlers[OnError]\Script Task" />
      </DTS:PrecedenceConstraints>
    </DTS:EventHandler>
