          SQLTask:SqlStatementSource="DECLARE @SessionId uniqueidentifier&#xA;DECLARE @ProcName varchar(128)&#xA;DECLARE @ProcSection varchar(50)&#xA;DECLARE @Status bit&#xA;DECLARE @ErrorMessage nvarchar(2044)&#xA;&#xA;EXECUTE [dbo].[Mark_Sold_Leads] &#xA;   @SessionId&#xA;  ,@ProcName OUTPUT&#xA;  ,@ProcSection OUTPUT&#xA;  ,@Status OUTPUT&#xA;  ,@ErrorMessage OUTPUT&#xA;GO&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
