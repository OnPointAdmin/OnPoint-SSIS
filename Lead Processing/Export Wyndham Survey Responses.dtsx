          <ProjectItem
            Name="ScriptMain.cs"
            Encoding="UTF8"><![CDATA[using System;
using System.Diagnostics;
using System.IO;
using System.Reflection;
using Microsoft.SqlServer.Dts.Runtime;
using Microsoft.SqlServer.Dts.Tasks.ScriptTask;
using WinSCP;

namespace ST_5a30686e70c04c5a8a93729fd90b8c79
{
    [SSISScriptTaskEntryPoint]
    public partial class ScriptMain : VSTARTScriptObjectModelBase
    {
        public void Main()
        {
            try
            {
                AppDomain.CurrentDomain.AssemblyResolve += ResolveWinScpNet;
                ExecuteTransfer();
            }
            catch (Exception ex)
            {
                Dts.Events.FireError(0, "SFTP", ex.ToString(), null, 0);
                Dts.TaskResult = (int)DTSExecResult.Failure;
            }
        }

        private static bool IsProductionHost()
        {
            return string.Equals(Environment.MachineName, "ONPOINTSQL1", StringComparison.OrdinalIgnoreCase);
        }

        private static string GetHostEnvironmentName()
        {
            return IsProductionHost() ? "Production" : "Developer";
        }

        private static string[] GetWinScpSearchFolders()
        {
            if (IsProductionHost())
            {
                return new string[]
                {
                    @"C:\SSISWinSCP",
                    @"C:\Program Files (x86)\WinSCP",
                    @"C:\Program Files\WinSCP"
                };
            }

            string localAppData = Environment.GetFolderPath(Environment.SpecialFolder.LocalApplicationData);
            return new string[]
            {
                Path.Combine(localAppData, "SSISWinSCP"),
                Path.Combine(localAppData, "Programs", "WinSCP"),
                @"C:\Program Files (x86)\WinSCP",
                @"C:\Program Files\WinSCP",
                @"D:\Users\Jason.Paine\OneDrive - onpointmrg.com\Repository\SSIS\OnPoint SSIS\Booking Processing\lib"
            };
        }

        private Assembly ResolveWinScpNet(object sender, ResolveEventArgs args)
        {
            if (args.Name == null || args.Name.IndexOf("WinSCPnet", StringComparison.OrdinalIgnoreCase) < 0)
            {
                return null;
            }

            foreach (string folder in GetWinScpSearchFolders())
            {
                string path = Path.Combine(folder, "WinSCPnet.dll");
                if (File.Exists(path))
                {
                    return Assembly.LoadFrom(path);
                }
            }

            return null;
        }

        private void ExecuteTransfer()
        {
            int retryCount = 3; // Number of retries
            int retryInterval = 5000; // Interval in milliseconds between retries
            bool fireAgain = false;

            Dts.Events.FireInformation(0, null,
                "Starting FTP transfer using WinSCP on " + Environment.MachineName +
                " (" + GetHostEnvironmentName() + ")",
                null, 0, ref fireAgain);

            while (retryCount > 0)
            {
                try
                {
                    SessionOptions sessionOptions = new SessionOptions
                    {
                        Protocol = Protocol.Sftp,
                        HostName = GetVariableValue("User::SFTPHostName"),
                        UserName = GetVariableValue("User::SFTPUserName"),
                        Password = GetVariableValue("User::SFTPPassword"),
                        SshHostKeyFingerprint = GetVariableValue("User::SFTPFingerprint")
                    };

                    using (Session session = new Session())
                    {
                        string exePath = GetWinScpExePath();
                        session.ExecutablePath = exePath;
                        Dts.Events.FireInformation(0, null,
                            "Using WinSCPnet " + typeof(Session).Assembly.Location +
                            " (" + GetLoadedWinScpNetProductVersion() + ") with " + exePath,
                            null, 0, ref fireAgain);

                        session.Open(sessionOptions);
                        Dts.Events.FireInformation(0, null, "Session opened successfully.", null, 0, ref fireAgain);

                        TransferOptions transferOptions = new TransferOptions
                        {
                            TransferMode = TransferMode.Binary,
                            PreserveTimestamp = false,
                            FilePermissions = null
                        };

                        string localFilePath = GetVariableValue("User::FilePath");
                        string remoteDirectory = GetVariableValue("User::SFTPRemoteDirectory");
                        TransferOperationResult transferResult = session.PutFiles(localFilePath, remoteDirectory, false, transferOptions);

                        transferResult.Check(); // Throws on error

                        foreach (TransferEventArgs transfer in transferResult.Transfers)
                        {
                            Dts.Events.FireInformation(0, null,
                                string.Format("Upload of {0} succeeded", transfer.FileName),
                                null, 0, ref fireAgain);
                        }

                        Dts.TaskResult = (int)DTSExecResult.Success;
                        Dts.Events.FireInformation(0, null, "FTP transfer completed successfully.", null, 0, ref fireAgain);
                        return; // Success, exit loop
                    }
                }
                catch (Exception e)
                {
                    if (e.Message.Contains("Authentication failed"))
                    {
                        Dts.Variables["User::ErrorOccurred"].Value = true;
                        Dts.Variables["User::ErrorMessage"].Value = e.Message;
                        Dts.Events.FireError(0, null,
                            "Authentication failed. No retries will be attempted for authentication errors.", null, 0);
                        Dts.TaskResult = (int)DTSExecResult.Failure;
                        return; // Exit immediately on authentication failure
                    }
                    else
                    {
                        retryCount--;
                        Dts.Variables["User::ErrorOccurred"].Value = true;
                        Dts.Variables["User::ErrorMessage"].Value = e.Message;
                        Dts.Events.FireError(0, null,
                            string.Format("Attempt failed - {0} retries left. Error: {1}", retryCount, e.Message),
                            null, 0);

                        if (retryCount > 0)
                        {
                            System.Threading.Thread.Sleep(retryInterval); // Wait before retrying
                        }
                        else
                        {
                            Dts.Events.FireError(0, null, "All retries failed. Task failed.", null, 0);
                            Dts.TaskResult = (int)DTSExecResult.Failure;
                        }
                    }
                }
            }
        }

        private string GetWinScpExePath()
        {
            string expectedProduct = GetLoadedWinScpNetProductVersion();
            string[] folders = GetWinScpSearchFolders();

            foreach (string folder in folders)
            {
                string path = Path.Combine(folder, "WinSCP.exe");
                if (File.Exists(path) && ProductVersionsMatch(path, expectedProduct))
                {
                    return path;
                }
            }

            throw new Exception(
                "No WinSCP.exe matching WinSCPnet product version '" + (expectedProduct ?? "(unknown)") +
                "' was found for " + GetHostEnvironmentName() + " host " + Environment.MachineName +
                ". Searched: " + string.Join("; ", folders));
        }

        private string GetLoadedWinScpNetProductVersion()
        {
            try
            {
                string location = typeof(Session).Assembly.Location;
                if (string.IsNullOrEmpty(location) || !File.Exists(location))
                {
                    return null;
                }

                return FileVersionInfo.GetVersionInfo(location).ProductVersion;
            }
            catch
            {
                return null;
            }
        }

        private bool ProductVersionsMatch(string exePath, string expectedProduct)
        {
            if (string.IsNullOrEmpty(expectedProduct))
            {
                return true;
            }

            string product = FileVersionInfo.GetVersionInfo(exePath).ProductVersion;
            return string.Equals(
                NormalizeProductVersion(product),
                NormalizeProductVersion(expectedProduct),
                StringComparison.OrdinalIgnoreCase);
        }

        private static string NormalizeProductVersion(string version)
        {
            if (string.IsNullOrEmpty(version))
            {
                return version;
            }

            string[] parts = version.Split('.');
            if (parts.Length >= 3)
            {
                return parts[0] + "." + parts[1] + "." + parts[2];
            }

            return version;
        }

        private string GetVariableValue(string variableName)
        {
            try
            {
                return (string)Dts.Variables[variableName].Value;
            }
            catch (Exception ex)
            {
                Dts.Events.FireError(0, null,
                    string.Format("Failed to access variable '{0}'. Error: {1}", variableName, ex.Message), null, 0);
                throw new Exception(string.Format("Error accessing SSIS variable '{0}': {1}", variableName, ex.Message), ex);
            }
        }
    }
}]]></ProjectItem>
