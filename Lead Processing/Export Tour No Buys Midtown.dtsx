              description="OLE DB Source"
              name="OLE DB Source"
              usesDispositions="true"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=17.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">SELECT [t].[Phone]  as PhoneNumber
	, [t].[FirstName]
	, [t].[LastName]
	, rtrim(CONCAT (
			[t].[Address]
			, ' '
			, [t].[Address2]
			)) AS [Address]
	, [t].[City]
	, [t].[State]
	, [t].[Zip_Code] as [Zip]
	, [t].[Email]
	, [t].[Age_Range] AS [AgeRange]
	, [t].[Income]
	, [t].[Marital_Status] AS [Marital Status]
	, [t].[Gender]
	, [t].Home_Owner AS [HomeOwner]
	, Cast([t].[ExportDate] as Date) as [ExportDate]
	, [t].[Id] as [OP_Id]
	, [t].[JornayaLeadId] as [JornayaLeadId]
	, [t].[Trusted_Form] as TrustedForm
	, [t].[Venue]
	, [t].[Event]
	, cast([t].Entry_Created_Date as DATE) as CreatedDate
    ,cast([t].[Partners_List] as varchar(1000)) as [Partners_List]
	, [t].[BookingId]
	, [t].[Phone_2]
	, [t].[FirstName2]
	, [t].[LastName2]
	, [t].[Address2]
	, [t].[TourLocation]
	, [t].[TourDate]
	, [t].[Premiums]
	, [t].[Tour_Result]
	, [t].[TourOrNoShow]
FROM [dbo].[Temp_Export_Leads] AS [t]</property>
