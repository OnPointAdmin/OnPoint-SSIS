all; comma-separated for multiple&#xA;SET @TourAgeStart =  ?&#xA;SET @TourAgeEnd = ?&#xA;SET @CheckPartnerList = 'false'&#xA;SET @CheckClientZips = ''&#xA;SET @ZipFileName = ''&#xA;SET @IncludeOrExcludeZip = ''&#xA;SET @States = ''--('ny,nj,ct')&#xA;SET @MinIncome = ''&#xA;SET @MaxIncome = ''&#xA;SET @MinAge = ''&#xA;SET @MaxAge = ''&#xA;SET @MaritalStatus = '' --Options: Married, Single Female, Single Male, All&#xA;&#xA;SET @ExcludeBookings = 'false'&#xA;SET @CheckSoldLeads =  'true'&#xA;SET @RecycledOnly = 'false'&#xA;SET @ExcludeSoldSameVertical = 'false'&#xA;SET @RecycleSameVerticalDate = ''&#xA;SET @RecycleSameClientDate = ''&#xA;SET @CheckClientSuppression = 'TRUE'&#xA;&#xA;SET @TourOrNoShow = ? --Tour or No Show&#xA;&#xA;EXECUTE [dbo].[Get_Leads_Bookings_1.0] @ClientName&#xA;    , @ExportName&#xA;&#x9;, @Vertical&#xA;&#x9;, @LeadSource&#xA;&#x9;, @Venue&#xA;&#x9;, @TourLocation&#xA;&#x9;, @CountRequested&#xA;&#x9;, @MinIncome&#xA;&#x9;, @MaxIncome&#xA;&#x9;, @MinAge&#xA;&#x9;, @MaxAge&#xA;&#x9;, @MaritalStatus&#xA;&#x9;, @TourAgeStart&#xA;&#x9;, @TourAgeEnd&#xA;&#x9;, @CheckPartnerList&#xA;&#x9;, @CheckClientZips&#xA;&#x9;, @CheckSoldLeads&#xA;&#x9;, @ZipFileName&#xA;&#x9;, @IncludeOrExcludeZip&#xA;&#x9;, @ZipFileSegment&#xA;&#x9;, @States&#xA;&#x9;, @ExcludeSoldSameVertical&#xA;&#x9;, @RecycledOnly&#xA;&#x9;, @RecycleSameVerticalDate&#xA;    , @RecycleSameClientDate&#xA;&#x9;, @CheckPartnerListField &#xA;&#x9;, @TourOrNoShow&#xA;&#x9;----------------------------&#xA;&#x9;, @SessionId&#xA;&#x9;, @ProcName OUTPUT&#xA;&#x9;, @ProcSection OUTPUT&#xA;&#x9;, @Status OUTPUT&#xA;&#x9;, @ErrorMessage OUTPUT&#xA;&#x9;, ? OUTPUT --Count Available&#xA;&#x9;, ? OUTPUT --CountReturned&#xA;&#x9;, @DupesPhone OUTPUT&#xA;&#x9;, @DupesEmail OUTPUT&#xA;   &#x9; , ? OUTPUT --SessionId&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="$Package::Client"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="129"
            SQLTask:ParameterSize="-1" />
