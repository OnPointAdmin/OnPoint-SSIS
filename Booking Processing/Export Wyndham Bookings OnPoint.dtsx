          DTS:Description="ZS HTML Email Task"
          DTS:DTSID="{F23B47D9-2644-4728-BBEF-31D6A3A68A98}"
          DTS:ExecutableType="ZappySys.HtmlEmailTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="ZS HTML Email Task">
          <DTS:Variables />
          <DTS:ObjectData>
            <HtmlEmailTask
              SmtpConnection="SMTP 1"
              UseInlineStyle="False"
              IsHtmlEmail="True"
              DefaultStyle="&#xA;&lt;style type=&quot;text/css&quot;&gt;&#xA;body,div,p,span,td,th,table {&#xA; font-family: Helvetica, Arial, sans-serif;&#xA; font-size: 10pt; &#xA;}&#xA;h1,h2,h3,h4,h5{&#xA;font-family: Helvetica, Arial, sans-serif;&#xA;}&#xA;&#xA;table { &#xA; border-collapse: &#xA; collapse; border-spacing: 0; &#xA;}&#xA;&#xA;tr.odd    {background-color: #cccccc}&#xA;tr.even   {background-color: #fafafa}&#xA;td, th { border: 1px solid #bbb;padding: 5 5 5 5} &#xA;th { background: #F3F3F3;  font-weight: bold;}&#xA;&lt;/style&gt;&#xA;&#xA;"
              Subject="SSIS Error Alert - {{System::PackageName}}"
              From="jason.paine@onpointmrg.com"
              To="jason.paine@onpointmrg.com"
              Cc=""
              ReplyTo=""
              Bcc=""
              Attachments=""
              EmailPriority="Normal"
              MessageSourceType="Direct"
              MessageDirectValue="&lt;h3&gt;SSIS Package Failed&lt;/h3&gt;&#xA;&lt;p&gt;&#xA;Package: {{System::PackageName}}&lt;br/&gt;&#xA;Task: {{System::SourceName}}&lt;br/&gt;&#xA;Error: {{System::ErrorDescription}}&lt;br/&gt;&#xA;Time: {{System::StartTime}}&#xA;&lt;/p&gt;&#xA;"
              MessageFileConnection=""
              MessageVariable=""
              LogLevel="Normal"
              PrefixTimestamp="False" />
          </DTS:ObjectData>
        </DTS:Executable>
      </DTS:Executables>
    </DTS:EventHandler>
  </DTS:EventHandlers>
