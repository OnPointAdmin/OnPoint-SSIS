    <DTS:Executable
      DTS:refId="Package\Set FileName"
      DTS:CreationName="Microsoft.ExpressionTask"
      DTS:Description="Expression Task"
      DTS:DTSID="{45BC26DD-8B44-45AE-B886-CCA84E3A4AFD}"
      DTS:ExecutableType="Microsoft.ExpressionTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Set FileName"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <ExpressionTask
          Expression="@[User::FileName]   = @[User::CompanyName] + &quot;_ThirdParty_Tours_&quot; +&#xA;Right(&quot;0&quot; + (DT_STR, 2, 1252) DatePart(&quot;m&quot;, getdate()), 2) + &#xA;Right(&quot;0&quot; + (DT_STR, 2, 1252) DatePart(&quot;d&quot;, getdate()), 2) +&#xA;(DT_STR, 4, 1252) DatePart(&quot;yyyy&quot;, getdate()) + &quot;_&quot; +&#xA;Right(&quot;0&quot; + (DT_STR, 2, 1252) DatePart(&quot;hh&quot;, getdate()), 2) +&#xA;Right(&quot;0&quot; + (DT_STR, 2, 1252) DatePart(&quot;mi&quot;, getdate()), 2) +&#xA;&quot;.csv&quot;" />
      </DTS:ObjectData>
    </DTS:Executable>
