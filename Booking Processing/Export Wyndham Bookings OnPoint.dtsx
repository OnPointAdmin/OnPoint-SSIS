          SQLTask:SqlStatementSource="SET ? = (SELECT Count(DISTINCT (t.[Vendor Reference ID])) AS [Count]&#xA;FROM [dbo].[Booking__c_Wyndham_OnPoint_Export] as t)" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::OutputCount"
            SQLTask:ParameterDirection="Output"
