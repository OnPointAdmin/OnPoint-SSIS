          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{ECA175E0-12CC-470D-B988-CFD149559703}"
              SQLTask:SqlStatementSource="Set ? = (Select count(*)&#xA;from  [dbo].[Temp_Wyndham_Upload_Results_Tour] as r &#xA;Where  isnull(Accept_Reject_Status,'')  = 'Accepted')" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
