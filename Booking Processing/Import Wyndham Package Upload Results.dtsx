    <OutputType>Library</OutputType>
    <RootNamespace>ST_a8c4e1f27b904d6e9a3c5d8f1b2e4a70</RootNamespace>
    <AssemblyName>ST_a8c4e1f27b904d6e9a3c5d8f1b2e4a70</AssemblyName>
