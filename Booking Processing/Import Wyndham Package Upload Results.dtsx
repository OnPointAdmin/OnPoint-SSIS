              SQLTask:SqlStatementSource="DECLARE @Sessionid uniqueidentifier&#xA;DECLARE @Procname varchar(128)&#xA;DECLARE @Procsection varchar(50)&#xA;DECLARE @Status bit&#xA;DECLARE @Errormessage nvarchar(2044)&#xA;&#xA;&#xA;EXECUTE  [dbo].[Booking__c_Wyndham_Upload_Result_Tour_Update]&#xA;   @Sessionid&#xA;  ,@Procname OUTPUT&#xA;  ,@Procsection OUTPUT&#xA;  ,@Status OUTPUT&#xA;  ,@Errormessage OUTPUT&#xA;GO" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
