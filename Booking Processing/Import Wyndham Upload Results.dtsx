          DTS:Description="File System Task"
          DTS:DTSID="{930BDEF2-4FD1-407F-A5BA-906AC02FEDF9}"
          DTS:ExecutableType="Microsoft.FileSystemTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Move to Archive Folder"
