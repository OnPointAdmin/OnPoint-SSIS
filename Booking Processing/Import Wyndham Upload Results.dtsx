          <ProjectItem
            Name="ScriptMain.cs"
            Encoding="UTF8"><![CDATA[using System;
using System.IO;
using System.Reflection;
using Microsoft.SqlServer.Dts.Runtime;
using Microsoft.SqlServer.Dts.Tasks.ScriptTask;
using WinSCP;

namespace ST_e7b91c4a2d8f46a3b5c0e1d4f8a27c69
{
    [SSISScriptTaskEntryPoint]
    public partial class ScriptMain : VSTARTScriptObjectModelBase
    {
        public void Main()
        {
            try
            {
                AppDomain.CurrentDomain.AssemblyResolve += ResolveWinScpNet;
                ExecuteTransfer();
            }
            catch (Exception ex)
            {
                string msg = ex.ToString();
                try
                {
                    File.WriteAllText(Path.Combine(Path.GetTempPath(), "ssis-sftp-download-error.txt"), msg);
                }
                catch
                {
                }

                Dts.Events.FireError(0, "SFTP", msg, null, 0);
                Dts.TaskResult = (int)DTSExecResult.Failure;
            }
        }

        private Assembly ResolveWinScpNet(object sender, ResolveEventArgs args)
        {
            if (args.Name == null || args.Name.IndexOf("WinSCPnet", StringComparison.OrdinalIgnoreCase) < 0)
            {
                return null;
            }

            string[] candidates = new string[]
            {
                Path.Combine(Path.GetDirectoryName(Assembly.GetExecutingAssembly().Location) ?? string.Empty, "WinSCPnet.dll"),
                @"C:\SSISWinSCP\WinSCPnet.dll",
                @"C:\Users\Jason.Paine\AppData\Local\Programs\WinSCP\WinSCPnet.dll",
                @"C:\Program Files (x86)\WinSCP\WinSCPnet.dll",
                @"C:\Program Files\WinSCP\WinSCPnet.dll",
                @"C:\Users\Jason.Paine\AppData\Local\SSISWinSCP\WinSCPnet.dll",
                @"D:\Users\Jason.Paine\OneDrive - onpointmrg.com\Repository\SSIS\OnPoint SSIS\Booking Processing\lib\WinSCPnet.dll"
            };

            foreach (string path in candidates)
            {
                if (!string.IsNullOrEmpty(path) && File.Exists(path))
                {
                    return Assembly.LoadFrom(path);
                }
            }

            return null;
        }

        private void ExecuteTransfer()
        {
            int retryCount = 3;
            int retryInterval = 5000;
            bool fireAgain = false;

            Dts.Events.FireInformation(0, null, "Starting SFTP download using WinSCP...", null, 0, ref fireAgain);

            while (retryCount > 0)
            {
                try
                {
                    SessionOptions sessionOptions = new SessionOptions
                    {
                        Protocol = Protocol.Sftp,
                        HostName = GetVariableValue("User::SFTPHostName"),
                        UserName = GetVariableValue("User::SFTPUserName"),
                        Password = GetVariableValue("User::SFTPPassword"),
                        SshHostKeyFingerprint = GetVariableValue("User::SFTPFingerprint")
                    };

                    using (Session session = new Session())
                    {
                        session.ExecutablePath = GetWinScpExePath();
                        session.Open(sessionOptions);
                        Dts.Events.FireInformation(0, null, "Session opened successfully.", null, 0, ref fireAgain);

                        TransferOptions transferOptions = new TransferOptions
                        {
                            TransferMode = TransferMode.Binary,
                            PreserveTimestamp = false,
                            FilePermissions = null
                        };

                        string remoteDirectory = GetVariableValue("User::SFTPRemoteDirectory").TrimEnd('/', '\\');
                        string localDirectory = GetVariableValue("User::varSourceFolder");

                        if (string.IsNullOrWhiteSpace(localDirectory))
                        {
                            throw new Exception("User::varSourceFolder is empty.");
                        }

                        localDirectory = Path.GetFullPath(localDirectory);
                        if (!Directory.Exists(localDirectory))
                        {
                            Directory.CreateDirectory(localDirectory);
                            Dts.Events.FireInformation(0, null,
                                "Created local inbound folder: " + localDirectory, null, 0, ref fireAgain);
                        }

                        string remoteArchiveDirectory = remoteDirectory + "/Archive";
                        if (!session.FileExists(remoteArchiveDirectory))
                        {
                            session.CreateDirectory(remoteArchiveDirectory);
                            Dts.Events.FireInformation(0, null,
                                "Created remote archive folder: " + remoteArchiveDirectory, null, 0, ref fireAgain);
                        }

                        Dts.Events.FireInformation(0, null,
                            string.Format("Downloading files from {0} to {1}", remoteDirectory, localDirectory),
                            null, 0, ref fireAgain);

                        RemoteDirectoryInfo listing = session.ListDirectory(remoteDirectory);
                        int fileCount = 0;
                        int skippedFolders = 0;

                        foreach (RemoteFileInfo fileInfo in listing.Files)
                        {
                            if (fileInfo.IsDirectory)
                            {
                                if (!fileInfo.IsThisDirectory && !fileInfo.IsParentDirectory)
                                {
                                    skippedFolders++;
                                    Dts.Events.FireInformation(0, null,
                                        "Skipping remote folder: " + fileInfo.Name, null, 0, ref fireAgain);
                                }
                                continue;
                            }

                            if (fileInfo.Name.IndexOf("RESPONSE_REPORTFILE", StringComparison.OrdinalIgnoreCase) < 0)
                            {
                                Dts.Events.FireInformation(0, null,
                                    "Skipping non-response file: " + fileInfo.Name, null, 0, ref fireAgain);
                                continue;
                            }

                            string remoteFilePath = remoteDirectory + "/" + fileInfo.Name;
                            string localPath = Path.Combine(localDirectory, fileInfo.Name);
                            string remoteArchivePath = remoteArchiveDirectory + "/" + fileInfo.Name;

                            using (Stream remoteStream = session.GetFile(remoteFilePath, transferOptions))
                            using (FileStream localStream = File.Create(localPath))
                            {
                                remoteStream.CopyTo(localStream);
                            }

                            if (!File.Exists(localPath) || new FileInfo(localPath).Length == 0 && fileInfo.Length > 0)
                            {
                                throw new Exception("Download did not create a local file. Expected: " + localPath);
                            }

                            long localLength = new FileInfo(localPath).Length;
                            Dts.Events.FireInformation(0, null,
                                string.Format("Saved {0} to {1} ({2} bytes)", fileInfo.Name, localPath, localLength),
                                null, 0, ref fireAgain);

                            if (session.FileExists(remoteArchivePath))
                            {
                                session.RemoveFile(remoteArchivePath);
                            }

                            session.MoveFile(remoteFilePath, remoteArchivePath);
                            fileCount++;
                            Dts.Events.FireInformation(0, null,
                                string.Format("Moved remote file to {0}", remoteArchivePath),
                                null, 0, ref fireAgain);
                        }

                        Dts.Events.FireInformation(0, null,
                            string.Format("SFTP download completed successfully. Files downloaded: {0}. Folders skipped: {1}", fileCount, skippedFolders),
                            null, 0, ref fireAgain);

                        Dts.TaskResult = (int)DTSExecResult.Success;
                        return;
                    }
                }
                catch (Exception e)
                {
                    if (e.Message.Contains("Authentication failed"))
                    {
                        Dts.Variables["User::ErrorOccurred"].Value = true;
                        Dts.Variables["User::ErrorMessage"].Value = e.Message;
                        Dts.Events.FireError(0, null,
                            "Authentication failed. No retries will be attempted for authentication errors.", null, 0);
                        Dts.TaskResult = (int)DTSExecResult.Failure;
                        return;
                    }
                    else
                    {
                        retryCount--;
                        Dts.Variables["User::ErrorOccurred"].Value = true;
                        Dts.Variables["User::ErrorMessage"].Value = e.Message;
                        Dts.Events.FireError(0, null,
                            string.Format("Attempt failed - {0} retries left. Error: {1}", retryCount, e.Message),
                            null, 0);

                        if (retryCount > 0)
                        {
                            System.Threading.Thread.Sleep(retryInterval);
                        }
                        else
                        {
                            Dts.Events.FireError(0, null, "All retries failed. Task failed.", null, 0);
                            Dts.TaskResult = (int)DTSExecResult.Failure;
                        }
                    }
                }
            }
        }

        private string GetWinScpExePath()
        {
            string[] candidates = new string[]
            {
                @"C:\SSISWinSCP\WinSCP.exe",
                @"C:\Program Files (x86)\WinSCP\WinSCP.exe",
                @"C:\Program Files\WinSCP\WinSCP.exe",
                @"C:\Users\Jason.Paine\AppData\Local\SSISWinSCP\WinSCP.exe",
                @"D:\Users\Jason.Paine\OneDrive - onpointmrg.com\Repository\SSIS\OnPoint SSIS\Booking Processing\lib\WinSCP.exe"
            };

            foreach (string path in candidates)
            {
                if (File.Exists(path))
                {
                    return path;
                }
            }

            throw new Exception("WinSCP.exe was not found. Install WinSCP or keep WinSCP.exe in Booking Processing\\lib.");
        }

        private string GetVariableValue(string variableName)
        {
            try
            {
                return (string)Dts.Variables[variableName].Value;
            }
            catch (Exception ex)
            {
                Dts.Events.FireError(0, null,
                    string.Format("Failed to access variable '{0}'. Error: {1}", variableName, ex.Message), null, 0);
                throw new Exception(string.Format("Error accessing SSIS variable '{0}': {1}", variableName, ex.Message), ex);
            }
        }
    }
}]]></ProjectItem>
