              <ProjectItem
                Name="ScriptMain.cs"
                Encoding="UTF8"><![CDATA[#region Namespaces
using System;
using Microsoft.SqlServer.Dts.Runtime;
#endregion

[Microsoft.SqlServer.Dts.Tasks.ScriptTask.SSISScriptTaskEntryPointAttribute]
public partial class ScriptMain : Microsoft.SqlServer.Dts.Tasks.ScriptTask.VSTARTScriptObjectModelBase
{
    private string GetVarAsString(string name, string defaultValue)
    {
        try
        {
            // Only variables included in ReadOnly/ReadWrite are accessible at runtime
            object v = Dts.Variables[name].Value;
            return (v == null) ? defaultValue : v.ToString();
        }
        catch
        {
            return defaultValue;
        }
    }

    public void Main()
    {
        try
        {
            string sentStr = GetVarAsString("User::EmailAlreadySent", "FALSE");
            bool alreadySent = sentStr.Equals("TRUE", StringComparison.OrdinalIgnoreCase);

            string pkg = GetVarAsString("System::PackageName", "");
            string machine = GetVarAsString("System::MachineName", "");
            string guid = GetVarAsString("System::ExecutionInstanceGUID", "");
            string execPath = GetVarAsString("System::ExecutionPath", "");
            string source = GetVarAsString("System::SourceName", "");
            string desc = GetVarAsString("System::ErrorDescription", "");

            int code = 0;
            try { code = Convert.ToInt32(GetVarAsString("System::ErrorCode", "0")); } catch { }

            // Your file variable (won’t crash if missing/not mapped)
            string fileName = GetVarAsString("User::varFileName", "");

            if (!alreadySent)
            {
                Dts.Variables["User::ErrorEmailSubject"].Value =
                    "SSIS FAILED: " + pkg + " on " + machine +
                    " (" + DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss") + ")" +
                    " Run=" + guid;
            }

            string currentBody = GetVarAsString("User::ErrorEmailBody", "");

            string safeDesc = System.Security.SecurityElement.Escape(desc);
            string safeSource = System.Security.SecurityElement.Escape(source);
            string safeExecPath = System.Security.SecurityElement.Escape(execPath);
            string safeFileName = System.Security.SecurityElement.Escape(fileName);

            string fileLine = "";
            if (!string.IsNullOrWhiteSpace(fileName))
                fileLine = "<div><b>File:</b> " + safeFileName + "</div>";

            string block =
                "<div style='font-family:Segoe UI,Arial; font-size:12px; margin-bottom:10px;'>" +
                "<div><b>Time:</b> " + DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss") + "</div>" +
                "<div><b>Package:</b> " + pkg + "</div>" +
                "<div><b>Machine:</b> " + machine + "</div>" +
                "<div><b>Execution GUID:</b> " + guid + "</div>" +
                fileLine +
                "<div><b>Source:</b> " + safeSource + "</div>" +
                "<div><b>Execution Path:</b> " + safeExecPath + "</div>" +
                "<div><b>ErrorCode:</b> " + code + "</div>" +
                "<div><b>Error:</b><pre style='white-space:pre-wrap; margin:6px 0;'>" + safeDesc + "</pre></div>" +
                "<hr/></div>";

            Dts.Variables["User::ErrorEmailBody"].Value = currentBody + block;

            Dts.TaskResult = (int)DTSExecResult.Success;
        }
        catch (Exception ex)
        {
            Dts.Events.FireError(0, "Error Handler Script", ex.ToString(), "", 0);
            Dts.TaskResult = (int)DTSExecResult.Failure;
        }
    }
}]]></ProjectItem>
