        <DTS:Executable
          DTS:refId="Package\Foreach Loop Container\ZS HTML Email Task"
          DTS:CreationName="ZappySys.HtmlEmailTask"
          DTS:Description="ZS HTML Email Task"
          DTS:DTSID="{965A3187-4A55-4505-A74A-E4B9EF8C2AE4}"
          DTS:ExecutableType="ZappySys.HtmlEmailTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="ZS HTML Email Task"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:PropertyExpression
            DTS:Name="To">@[$Package::EmailRecipients]</DTS:PropertyExpression>
          <DTS:ObjectData>
            <HtmlEmailTask
              SmtpConnection="SMTP 1"
              UseInlineStyle="False"
              IsHtmlEmail="True"
              DefaultStyle="&#xA;&lt;style type=&quot;text/css&quot;&gt;&#xA;body,div,p,span,td,th,table {&#xA; font-family: Helvetica, Arial, sans-serif;&#xA; font-size: 10pt; &#xA;}&#xA;h1,h2,h3,h4,h5{&#xA;font-family: Helvetica, Arial, sans-serif;&#xA;}&#xA;&#xA;table { &#xA; border-collapse: &#xA; collapse; border-spacing: 0; &#xA;}&#xA;&#xA;tr.odd    {background-color: #cccccc}&#xA;tr.even   {background-color: #fafafa}&#xA;td, th { border: 1px solid #bbb;padding: 5 5 5 5} &#xA;th { background: #F3F3F3;  font-weight: bold;}&#xA;&lt;/style&gt;&#xA;&#xA;"
              Subject="Bookings Uploaded to Wyndham {{User::varFileName}}"
              From="jason.paine@onpointmrg.com"
              To="jason.paine@onpointmrg.com"
              Cc=""
              ReplyTo=""
              Bcc=""
              Attachments="{{User::varArchivePath}}"
              EmailPriority="Normal"
              MessageSourceType="Direct"
              MessageDirectValue="&lt;b&gt;Wyndham Tour Upload&lt;/b&gt;&#xA;&lt;br/&gt;File Name: {{User::varFileName}}&#xA;&lt;p&gt;&#xA;&lt;ul&gt;&#xA;  &lt;li&gt;Count Total: {{User::TotalRecords}}&lt;/li&gt;&#xA;  &lt;li&gt;Count Accepted: {{User::CountAccepted}}&lt;/li&gt;&#xA;  &lt;li&gt;Count Rejected: {{User::CountRejected}}&lt;/li&gt;&#xA;  &lt;li&gt;Count Errors: {{User::CountErrors}}&lt;/li&gt;&#xA;&lt;/ul&gt;&lt;p /&gt;&#xA;&#xA;&lt;h2&gt;Processed Bookings&lt;h2&gt;&#xA;{{User::BadRecords,table}}&#xA;"
              MessageFileConnection=""
              MessageVariable=""
              LogLevel="Normal"
              PrefixTimestamp="False" />
          </DTS:ObjectData>
        </DTS:Executable>
