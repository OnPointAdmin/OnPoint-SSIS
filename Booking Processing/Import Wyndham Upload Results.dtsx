        <DTS:Executable
          DTS:refId="Package\Foreach Loop Container\Get Records"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{6F73C0DF-BEC9-4B70-8E89-A04618A7B805}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Get Records"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{ECA175E0-12CC-470D-B988-CFD149559703}"
              SQLTask:SqlStatementSource="SELECT b.Name as Booking_Number,r.First_Name,r.Last_Name,r.Mobile,Sales_Site,LEFT(r.Tour_Date,10) AS Tour_Date,left(r.Tour_Time,5) as Tour_Time,Accept_Reject_Status&#xA;&#x9;,r.WorkOrderNumber&#xA;FROM [SalesforceInterface].[dbo].[Temp_Wyndham_Upload_Results_Tour] as r &#xA;&#x9;left Join SalesforceBackup.dbo.Booking__c as b on substring(r.[Vendor_Reference_Id],CHARINDEX('-',r.[Vendor_Reference_Id])+1,18) = b.Id&#xA;--Where  isnull(Accept_Reject_Status,'') Not In ('Accepted')&#xA;ORDER BY R.Accept_Reject_Status,b.name"
              SQLTask:ResultType="ResultSetType_Rowset" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
              <SQLTask:ResultBinding
                SQLTask:ResultName="0"
                SQLTask:DtsVariableName="User::BadRecords" />
            </SQLTask:SqlTaskData>
          </DTS:ObjectData>
        </DTS:Executable>
