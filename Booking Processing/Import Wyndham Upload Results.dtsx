        <DTS:Executable
          DTS:refId="Package\Foreach Loop Container\Check Response File"
          DTS:CreationName="Microsoft.ExpressionTask"
          DTS:Description="True only for Wyndham RESPONSE_REPORTFILE names; send files take the skip path"
          DTS:DTSID="{C4F81A27-3E9B-4D62-A105-8B7C6D5E4F31}"
          DTS:ExecutableType="Microsoft.ExpressionTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Check Response File"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <ExpressionTask
              Expression="@[User::IsResponseFile] = FINDSTRING(UPPER(@[User::varFileName]), &quot;RESPONSE_REPORTFILE&quot;, 1) &gt; 0" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\Foreach Loop Container\Create Archive Folder"
          DTS:CreationName="Microsoft.FileSystemTask"
          DTS:Description="File System Task"
          DTS:DTSID="{598F8685-4A26-48FB-B577-139123E8D8C8}"
          DTS:ExecutableType="Microsoft.FileSystemTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Create Archive Folder"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <FileSystemData
              TaskOperationType="CreateDirectory"
              TaskOverwriteDestFile="True"
              TaskSourcePath="User::varArchiveFolder"
              TaskIsSourceVariable="True" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\Foreach Loop Container\Create Unexpected Archive Folder"
          DTS:CreationName="Microsoft.FileSystemTask"
          DTS:Description="Ensure Archive exists before moving a skipped send file"
          DTS:DTSID="{D5A92B38-4FAC-4E73-B216-9C8D7E6F5042}"
          DTS:ExecutableType="Microsoft.FileSystemTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Create Unexpected Archive Folder"
          DTS:ThreadHint="1">
          <DTS:Variables />
          <DTS:ObjectData>
            <FileSystemData
              TaskOperationType="CreateDirectory"
              TaskOverwriteDestFile="True"
              TaskSourcePath="User::varArchiveFolder"
              TaskIsSourceVariable="True" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\Foreach Loop Container\Email Unexpected File"
          DTS:CreationName="ZappySys.HtmlEmailTask"
          DTS:Description="Explain that an outbound send file was skipped instead of imported"
          DTS:DTSID="{F7C14D5A-61CE-4095-D438-BE0F90817264}"
          DTS:ExecutableType="ZappySys.HtmlEmailTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Email Unexpected File"
          DTS:ThreadHint="1">
          <DTS:Variables />
          <DTS:PropertyExpression
            DTS:Name="Subject">"Wyndham import skipped unexpected file: " + @[User::varFileName]</DTS:PropertyExpression>
          <DTS:PropertyExpression
            DTS:Name="To">@[$Package::EmailRecipients]</DTS:PropertyExpression>
          <DTS:ObjectData>
            <HtmlEmailTask
              SmtpConnection="SMTP 1"
              UseInlineStyle="False"
              IsHtmlEmail="True"
              DefaultStyle="&#xA;&lt;style type=&quot;text/css&quot;&gt;&#xA;body,div,p,span,td,th,table {&#xA; font-family: Helvetica, Arial, sans-serif;&#xA; font-size: 10pt; &#xA;}&#xA;&lt;/style&gt;&#xA;"
              Subject="Wyndham import skipped unexpected file: 20240513125347_OnPoint_3rdParty_RESPONSE_REPORTFILE.csv"
              From="alerts@onpointmrg.com"
              To="jason.paine@onpointmrg.com"
              Cc=""
              ReplyTo=""
              Bcc=""
              Attachments=""
              EmailPriority="Normal"
              MessageSourceType="Direct"
              MessageDirectValue="&lt;b&gt;Wyndham upload results — unexpected inbound file&lt;/b&gt;&#xA;&lt;p&gt;File &lt;b&gt;{{User::varFileName}}&lt;/b&gt; is not a Wyndham response report.&lt;/p&gt;&#xA;&lt;p&gt;Import only processes &lt;code&gt;*RESPONSE_REPORTFILE*.csv&lt;/code&gt; files (last columns: Notes, isVacationPassEligible). This name looks like an outbound &lt;code&gt;OnPoint_ThirdParty_Tours&lt;/code&gt; send file, which is why a previous run failed with &lt;i&gt;The column delimiter for column Notes was not found&lt;/i&gt;.&lt;/p&gt;&#xA;&lt;p&gt;The file was &lt;b&gt;not imported&lt;/b&gt; and was moved to Archive:&lt;br/&gt;{{User::varArchivePath}}&lt;/p&gt;&#xA;&lt;p&gt;A real response file in the same folder, if present, is still imported.&lt;/p&gt;"
              MessageFileConnection=""
              MessageVariable=""
              LogLevel="Normal"
              PrefixTimestamp="False" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\Foreach Loop Container\Execute Bookng Tour Result Update"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{68177152-0CDF-453A-9C75-6945BA184ED6}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Execute Bookng Tour Result Update"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{ECA175E0-12CC-470D-B988-CFD149559703}"
              SQLTask:SqlStatementSource="DECLARE @Sessionid uniqueidentifier&#xA;DECLARE @Procname varchar(128)&#xA;DECLARE @Procsection varchar(50)&#xA;DECLARE @Status bit&#xA;DECLARE @Errormessage nvarchar(2044)&#xA;&#xA;&#xA;EXECUTE  [dbo].[Booking__c_Wyndham_Upload_Result_Tour_Update]&#xA;   @Sessionid&#xA;  ,@Procname OUTPUT&#xA;  ,@Procsection OUTPUT&#xA;  ,@Status OUTPUT&#xA;  ,@Errormessage OUTPUT&#xA;GO" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\Foreach Loop Container\Get Accepted Count"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{65fae1e2-c7df-4a0c-b521-8a87e295258c}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Get Accepted Count"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{ECA175E0-12CC-470D-B988-CFD149559703}"
              SQLTask:SqlStatementSource="Set ? = (Select count(*)&#xA;from  [dbo].[Temp_Wyndham_Upload_Results_Tour] as r &#xA;Where  isnull(Accept_Reject_Status,'')  = 'Accepted')" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
              <SQLTask:ParameterBinding
                SQLTask:ParameterName="0"
                SQLTask:DtsVariableName="User::CountAccepted"
                SQLTask:ParameterDirection="Output"
                SQLTask:DataType="3"
                SQLTask:ParameterSize="-1" />
            </SQLTask:SqlTaskData>
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\Foreach Loop Container\Get Count Errors"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{fe92954c-c87b-49ca-bfec-bc639dd0d042}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Get Count Errors"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{ECA175E0-12CC-470D-B988-CFD149559703}"
              SQLTask:SqlStatementSource="Set ? = (Select Count(*)&#xA;From [SalesforceBackup].[dbo].[Booking__c_Wyndham_Upload_Result_Tour_Update]&#xA;WHERE isnull(error,'') &lt;&gt; 'Operation Successful.')" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
              <SQLTask:ParameterBinding
                SQLTask:ParameterName="0"
                SQLTask:DtsVariableName="User::CountErrors"
                SQLTask:ParameterDirection="Output"
                SQLTask:DataType="3"
                SQLTask:ParameterSize="-1" />
            </SQLTask:SqlTaskData>
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\Foreach Loop Container\Get Not Accepted"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{a1ed47a8-3393-422d-9b30-bd57958dbfc6}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Get Not Accepted"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{ECA175E0-12CC-470D-B988-CFD149559703}"
              SQLTask:SqlStatementSource="Set ? = (Select count(*)&#xA;from  [dbo].[Temp_Wyndham_Upload_Results_Tour] as r &#xA;Where  isnull(Accept_Reject_Status,'')  &lt;&gt; 'Accepted')" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
              <SQLTask:ParameterBinding
                SQLTask:ParameterName="0"
                SQLTask:DtsVariableName="User::CountRejected"
                SQLTask:ParameterDirection="Output"
                SQLTask:DataType="3"
                SQLTask:ParameterSize="-1" />
            </SQLTask:SqlTaskData>
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\Foreach Loop Container\Get Records"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{6F73C0DF-BEC9-4B70-8E89-A04618A7B805}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Get Records"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{ECA175E0-12CC-470D-B988-CFD149559703}"
              SQLTask:SqlStatementSource="SELECT b.Name as Booking_Number,r.First_Name,r.Last_Name,r.Mobile,Sales_Site,LEFT(r.Tour_Date,10) AS Tour_Date,left(r.Tour_Time,5) as Tour_Time,Accept_Reject_Status&#xA;&#x9;,r.WorkOrderNumber&#xA;FROM [SalesforceInterface].[dbo].[Temp_Wyndham_Upload_Results_Tour] as r &#xA;&#x9;left Join SalesforceBackup.dbo.Booking__c as b on substring(r.[Vendor_Reference_Id],CHARINDEX('-',r.[Vendor_Reference_Id])+1,18) = b.Id&#xA;--Where  isnull(Accept_Reject_Status,'') Not In ('Accepted')&#xA;ORDER BY R.Accept_Reject_Status,b.name"
              SQLTask:ResultType="ResultSetType_Rowset" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
              <SQLTask:ResultBinding
                SQLTask:ResultName="0"
                SQLTask:DtsVariableName="User::BadRecords" />
